{
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "crons": [
    { "path": "/api/reminders.js", "schedule": "0 1 * * *" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/sitemap.xml", "dest": "/api/sitemap.xml.js" },
    { "src": "/ops", "dest": "/ops.html" },
    { "src": "/insights/([^/]+)/([^/]+)", "dest": "/api/seo-page.js?category=$1&slug=$2" },
    { "src": "/insights", "dest": "/api/seo-index.js" },
    { "src": "/method", "dest": "/index.html" },
    { "src": "/courses", "dest": "/index.html" },
    { "src": "/about", "dest": "/index.html" },
    { "src": "/level-check", "dest": "/index.html" },
    { "src": "/faq", "dest": "/index.html" },
    { "src": "/booking", "dest": "/index.html" },
    { "src": "/contact", "dest": "/index.html" },
    { "src": "/diagnostic", "dest": "/index.html" },
    { "src": "/daily", "dest": "/index.html" },
    { "src": "/business", "dest": "/index.html" },
    { "src": "/hsk", "dest": "/index.html" },
    { "src": "/specialty", "dest": "/index.html" },
    { "src": "/private", "dest": "/index.html" },
    { "src": "/sourcing-spotlight", "dest": "/index.html" },
    { "src": "/corporate-programs", "dest": "/corporate.html" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
